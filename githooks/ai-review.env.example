# Copy this file to .ai-review.env in each repository, or to ~/.ai-review.env
# for a shared user-level configuration.
#
# Do not commit real API keys.

AI_REVIEW_ENABLED=true
AI_REVIEW_API_KEY=replace_with_your_api_key
AI_REVIEW_MODEL=gpt-4o-mini
# Supports either https://example.com/v1 or https://example.com/v1/chat/completions.
AI_REVIEW_BASE_URL=https://api.openai.com/v1/chat/completions

# Default mode: only send staged diff to AI. No Maven/Gradle/Node command runs.
AI_REVIEW_COMPILE=false
AI_REVIEW_RUN_TESTS=false

# API failures only print warnings by default and do not block commit.
AI_REVIEW_REQUIRE_API=false
AI_REVIEW_FAIL_ON_AI_ERROR=false
AI_REVIEW_FAIL_ON_FINDINGS=false

# Override these per project when auto-detection is not enough.
# AI_REVIEW_BUILD_CMD=./mvnw.cmd -q -DskipTests compile
# AI_REVIEW_TEST_CMD=./mvnw.cmd -q test

# Prevent huge commits from sending too much code to the model.
AI_REVIEW_MAX_DIFF_BYTES=120000
# Send lightweight project context related to changed files.
AI_REVIEW_CONTEXT_ENABLED=true
AI_REVIEW_CONTEXT_MAX_BYTES=80000
AI_REVIEW_CONTEXT_MAX_FILE_BYTES=20000
AI_REVIEW_TIMEOUT_SECONDS=90

# Default mode runs AI review in the background so commit does not wait for network calls.
AI_REVIEW_ASYNC=true

# Optional notifications. Values: always, fail, error, never.
AI_REVIEW_NOTIFY_ON=always
# Local desktop notification. Supports macOS osascript, Windows PowerShell, and Linux notify-send.
AI_REVIEW_DESKTOP_NOTIFY=true
# Windows custom notification auto-close seconds.
AI_REVIEW_DESKTOP_NOTIFY_SECONDS=8
# Desktop report open mode. Windows supports native or file.
AI_REVIEW_DESKTOP_OPEN_MODE=native
# macOS only: automatically open a native report dialog after the notification.
AI_REVIEW_DESKTOP_AUTO_OPEN_REPORT=false
# AI_REVIEW_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# AI_REVIEW_WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# AI_REVIEW_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
#
# Optional email notification.
# AI_REVIEW_EMAIL_TO=dev@example.com
# AI_REVIEW_EMAIL_FROM=bot@example.com
# AI_REVIEW_SMTP_HOST=smtp.example.com
# AI_REVIEW_SMTP_PORT=587
# AI_REVIEW_SMTP_USERNAME=bot@example.com
# AI_REVIEW_SMTP_PASSWORD=replace_with_smtp_password
# AI_REVIEW_SMTP_STARTTLS=true
# AI_REVIEW_SMTP_SSL=false
